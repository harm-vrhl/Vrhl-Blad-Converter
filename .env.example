# ─── Tokens ──────────────────────────────────────────────────────────────────
# Vul deze in .env.local in (die staat in .gitignore).
MISTRAL_API_KEY=
OPENAI_API_KEY=

# ─── Toegang ─────────────────────────────────────────────────────────────────
# Eén gedeeld wachtwoord voor de hele app. Leeg = geen slot (lokaal handig).
# Op Vercel ALTIJD invullen: elke API-route gebruikt de sleutels hierboven.
APP_PASSWORD=
# Waarmee de inlogcookie wordt ondertekend. Een lange willekeurige tekst, bv.
# de uitvoer van: openssl rand -hex 32
AUTH_SECRET=

# ─── Sanity ──────────────────────────────────────────────────────────────────
# Alleen nodig om het pakket naar het CMS te duwen; zonder deze drie werkt de
# converter gewoon, alleen de knop Push naar Sanity blijft dan uit.
#
# Het token heeft SCHRIJFRECHTEN nodig (rol Editor of hoger). Maak er een aan op
# sanity.io/manage onder API > Tokens. Alles wordt als concept weggeschreven
# (drafts.*), dus een import kan nooit meteen live staan.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
# De API-versie waartegen geschreven wordt. Vastgepind, niet 'latest', zodat een
# wijziging aan Sanity's kant niet ongemerkt het gedrag verandert.
SANITY_API_VERSION=2024-01-01

# ─── Modellen ────────────────────────────────────────────────────────────────
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Welk model het artikel schrijft: openai | mistral.
AI_PROVIDER=openai
# Mag de gebruiker per run zelf kiezen? Standaard niet: dan schrijft AI_PROVIDER
# alles, is de keuzeknop weg en negeert de server wat de browser vraagt. Zet op
# true om de keuze terug te zetten (Mistral Medium 3.5 was niet goed genoeg).
AI_PROVIDER_CHOICE=false

OPENAI_MODEL=gpt-5.6-terra
# Mistral Medium 3.5, vastgepind op versie zodat een run herhaalbaar is.
MISTRAL_MODEL=mistral-medium-2604

# minimal | low | medium | high. 'medium' is de stand waarop dit is afgestemd
OPENAI_REASONING_EFFORT=medium
# Mistral Medium 3.5 accepteert alleen none of high. high is dezelfde kwaliteit
# als OpenAI-medium (dat Mistral weigerde en naar high remapte), zonder de
# mislukte eerste call die een rate-limit-slot kost.
MISTRAL_REASONING_EFFORT=high

# responses | chat. 'responses' valt automatisch terug op 'chat' bij een 404/400
OPENAI_API_STYLE=responses

# ─── Endpoints ───────────────────────────────────────────────────────────────
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Pipeline ────────────────────────────────────────────────────────────────
# Hoeveel AI-runs tegelijk. Hoger = sneller; Mistral start er alsnog max 1 per seconde.
MAX_CONCURRENCY=4
# 60 = 1 aanvraag per seconde, de limiet op Medium 3.5. De client start nooit
# sneller, ook niet als een header meer belooft. Een limiet van 0 op
# admin.mistral.ai/plateforme/limits blijft een harde stop.
MISTRAL_REQ_PER_MINUTE=60
# Onder deze waarde markeert de pipeline een beslissing als onbetrouwbaar
# en triggert een tweede, gespecialiseerde controle-run.
CONFIDENCE_THRESHOLD=0.7

# ── Opmaak lezen uit uitsnedes van de pagina (optioneel) ─────────────────────
# Mistral markeert vet en cursief in zijn markdown, maar alleen als het de type
# ziet waartegen het moet vergelijken. Een hele pagina overspoelt het (twee
# pagina's van een testartikel kwamen leeg terug terwijl er vette interviewvragen
# stonden); een kaal blok geeft het juist geen referentie. Eén blok plus een
# strook van de buren werkt wel.
# Kost een OCR-call per blok in plaats van één voor het document, dus uit tenzij
# je erom vraagt. Wat het kost wordt geteld en getoond.
OCR_BLOCK_STYLING=false
# Hoeveel van de buren een blok te zien krijgt, in OCR-punten boven en onder.
# 40 mist markeringen, 140 ook; 70 was het optimum in de meting.
OCR_BLOCK_MARGIN=70

# ── Wat een run kost ────────────────────────────────────────────────────────
# Lijstprijzen van de aanbieders zelf, in dollar, opgezocht september 2026.
# Alleen aanpassen als OPENAI_MODEL iets anders noemt of als je in een andere
# valuta wilt rekenen; PRICE_CURRENCY is puur het label op het totaal.
#
# gpt-5.6-terra: $2 per 1M invoertokens, $12 per 1M uitvoertokens.
# Een cached invoer-read kost $0,10 per 1M, maar het grootboek weet niet welke
# reads cached waren, dus het modeldeel van de rekening is een bovengrens.
OPENAI_PRICE_INPUT=2
OPENAI_PRICE_OUTPUT=12
# Mistral OCR: $4 per 1000 pagina's. Een uitsnede telt als een hele pagina.
MISTRAL_PRICE_PER_PAGE=0.004
# Mistral Medium 3.5: $1,50 in / $7,50 uit per 1M tokens.
MISTRAL_PRICE_INPUT=1.5
MISTRAL_PRICE_OUTPUT=7.5
PRICE_CURRENCY=USD

# ── Magazine in kaart brengen ──────────────────────────────────────────────
# Een heel magazine wordt pagina voor pagina gelezen om te vinden waar de
# artikelen staan. Dat is beoordelen, geen schrijven, dus een goedkoper model.
# Twijfelt het bij een grens, dan kijkt het gewone model (OPENAI_MODEL of
# MISTRAL_MODEL) nog een keer.
# gpt-5.6-luna: $0,20 in / $1,20 uit per 1M tokens.
OPENAI_MAGAZINE_MODEL=gpt-5.6-luna
OPENAI_MAGAZINE_PRICE_INPUT=0.2
OPENAI_MAGAZINE_PRICE_OUTPUT=1.2
# Leeg = MISTRAL_MODEL, met de prijzen daarvan.
MISTRAL_MAGAZINE_MODEL=
# Hoeveel gekozen artikelen tegelijk worden omgezet. Elk artikel draait zijn
# pagina's ook al parallel (MAX_CONCURRENCY). Mistral blijft 1 start per seconde.
MAGAZINE_ARTICLE_CONCURRENCY=3
