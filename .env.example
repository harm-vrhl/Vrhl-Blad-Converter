# ─── Tokens ──────────────────────────────────────────────────────────────────
# Vul deze in .env.local in (die staat in .gitignore).
MISTRAL_API_KEY=
OPENAI_API_KEY=

# ─── Modellen ────────────────────────────────────────────────────────────────
MISTRAL_OCR_MODEL=mistral-ocr-latest
OPENAI_MODEL=gpt-5.6-terra

# minimal | low | medium | high. 'medium' is de stand waarop dit is afgestemd
OPENAI_REASONING_EFFORT=medium

# responses | chat. 'responses' valt automatisch terug op 'chat' bij een 404/400
OPENAI_API_STYLE=responses

# ─── Endpoints ───────────────────────────────────────────────────────────────
MISTRAL_BASE_URL=https://api.mistral.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Pipeline ────────────────────────────────────────────────────────────────
# Hoeveel AI-runs tegelijk. Hoger = sneller, meer rate-limit risico.
MAX_CONCURRENCY=4
# Onder deze waarde markeert de pipeline een beslissing als onbetrouwbaar
# en triggert een tweede, gespecialiseerde controle-run.
CONFIDENCE_THRESHOLD=0.7
# Waar jobs (page images, OCR, tussenresultaten) worden weggeschreven.
DATA_DIR=.data

# ── Opmaak lezen uit uitsnedes van de pagina (optioneel) ─────────────────────
# Mistral markeert vet en cursief in zijn markdown, maar alleen als het de type
# ziet waartegen het moet vergelijken. Een hele pagina overspoelt het (twee
# pagina's van een testartikel kwamen leeg terug terwijl er vette interviewvragen
# stonden); een kaal blok geeft het juist geen referentie. Eén blok plus een
# strook van de buren werkt wel.
# Kost een OCR-call per blok in plaats van één voor het document, dus uit tenzij
# je erom vraagt. Wat het kost wordt geteld en getoond.
OCR_BLOCK_STYLING=false
# Hoeveel van de buren een blok te zien krijgt, in OCR-punten boven en onder.
# 40 mist markeringen, 140 ook; 70 was het optimum in de meting.
OCR_BLOCK_MARGIN=70

# ── Wat een run kost ────────────────────────────────────────────────────────
# Lijstprijzen van de aanbieders zelf, in dollar, opgezocht september 2026.
# Alleen aanpassen als OPENAI_MODEL iets anders noemt of als je in een andere
# valuta wilt rekenen; PRICE_CURRENCY is puur het label op het totaal.
#
# gpt-5.6-terra: $2 per 1M invoertokens, $12 per 1M uitvoertokens.
# Een cached invoer-read kost $0,10 per 1M, maar het grootboek weet niet welke
# reads cached waren, dus het modeldeel van de rekening is een bovengrens.
OPENAI_PRICE_INPUT=2
OPENAI_PRICE_OUTPUT=12
# Mistral OCR: $4 per 1000 pagina's. Een uitsnede telt als een hele pagina.
MISTRAL_PRICE_PER_PAGE=0.004
PRICE_CURRENCY=USD
